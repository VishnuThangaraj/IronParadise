<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IronParadise - Coimbatore</title>

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />

    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #f2f2f2;
        color: #333;
      }

      .container {
        max-width: 700px;
        margin: 20px auto;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.08);
        overflow: hidden;
      }

      .header {
        text-align: center;
        padding: 60px 20px;
        background: url("https://media.istockphoto.com/id/1369897943/photo/focus-on-disc-close-up-shot-hands-adding-weight-to-barbell-rod-at-gym-concept-of-fitness.jpg?s=612x612&w=0&k=20&c=H0fxQoJGyMv9npWuD42R6xiG8JUpqZNPbp4dLWh7B7k=")
          center / cover no-repeat;
        color: #fff;
        text-shadow: 5px 5px 10px #000;
      }

      .header h1 {
        margin: 0;
        font-size: 36px;
        font-weight: bold;
        text-transform: uppercase;
      }

      /* Content */
      .content {
        padding: 20px;
        background-color: #f9f9f9;
      }

      h2 {
        margin-top: 0;
        font-size: 28px;
        color: gray;
      }

      p {
        margin: 0 0 15px;
        font-size: 16px;
        line-height: 1.6;
        color: #555;
      }

      a {
        color: #000;
        font-weight: bold;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      /* Footer */
      .footer {
        background: #eee;
        padding: 20px;
        border-top: 1px solid #ddd;
      }

      .footer h2 {
        font-size: 20px;
        color: #000;
        margin-bottom: 10px;
      }

      .footer p {
        font-size: 14px;
        color: #666;
      }

      .footer ul {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .footer li {
        margin-bottom: 10px;
      }

      .socials {
        text-align: center;
        margin-top: 20px;
      }

      .socials a {
        margin: 0 12px;
        font-size: 22px;
        color: gray;
        transition: color 0.3s ease;
      }

      .socials a:hover {
        color: #000;
      }

      /* Mobile Optimization */
      @media (max-width: 600px) {
        .header {
          padding: 40px 15px;
        }

        .header h1 {
          font-size: 26px;
        }

        h2 {
          font-size: 22px;
        }

        p {
          font-size: 15px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <div class="header">
        <h1>Iron Paradise</h1>
      </div>

      <div class="content">{{{body}}}</div>

      <div class="footer">
        <div class="section">
          <h2>Contact Information</h2>
          <p><strong>Iron Paradise</strong></p>
          <p>12, Alpha Street, Sulur, Coimbatore - 641402</p>
          <p>Phone: +91 9385 884 584</p>
        </div>

        <div class="section">
          <h2>Support</h2>
          <p>If you need assistance, please contact our support team:</p>
          <p>
            Email:
            <a href="mailto:vishnuthangaraj.developer@gmail.com">
              vishnuthangaraj.developer@gmail.com
            </a>
          </p>
          <p>Phone: +91 9385 884 584</p>
        </div>

        <div class="section">
          <h2>Follow Us</h2>
          <p>Connect with us on social media for updates and news:</p>
          <div class="socials">
            <a
              href="https://facebook.com"
              target="_blank"
              rel="noopener"
              title="Facebook"
            >
              <i class="fab fa-facebook-f"></i>
            </a>
            <a
              href="https://twitter.com"
              target="_blank"
              rel="noopener"
              title="Twitter"
            >
              <i class="fab fa-twitter"></i>
            </a>
            <a
              href="https://instagram.com"
              target="_blank"
              rel="noopener"
              title="Instagram"
            >
              <i class="fab fa-instagram"></i>
            </a>
            <a
              href="https://www.tiktok.com"
              target="_blank"
              rel="noopener"
              title="TikTok"
            >
              <i class="fab fa-tiktok"></i>
            </a>
            <a
              href="https://wa.me/6584857496"
              target="_blank"
              rel="noopener"
              title="WhatsApp"
            >
              <i class="fab fa-whatsapp"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>